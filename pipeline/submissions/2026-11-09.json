    "grammar": [
      {
        "pattern": "可能形：五段動詞",
        "meaning": "表示能力、可能性，『能夠做』。",
        "connection": "五段動詞最後的う段改成同一行え段＋る：読む→読める、話す→話せる、泳ぐ→泳げる、弾く→弾ける。",
        "usage": "可能形本身按一段動詞活用：読める／読めない／読めた／読めなかった。能力對象常用が。",
        "examples": [
          {
            "jp": "この本が読めます。",
            "zh": "我能讀這本書。"
          },
          {
            "jp": "私は日本語が話せない。",
            "zh": "我不會說日文。"
          },
          {
            "jp": "子どもの時、泳げなかった。",
            "zh": "小時候不會游泳。"
          }
        ]
      },
      {
        "pattern": "可能形：一段動詞與不規則動詞",
        "meaning": "表示可以做某事。",
        "connection": "一段去る＋られる：食べる→食べられる、開ける→開けられる、借りる→借りられる；する→できる；来る（くる）→来られる（こられる）。",
        "usage": "先記標準形式，口語省略ら的形式暫不作考試標準答案。可能形的否定為食べられない、できない。",
        "examples": [
          {
            "jp": "辛い物が食べられます。",
            "zh": "我能吃辣。"
          },
          {
            "jp": "今日は車を運転できません。",
            "zh": "今天不能開車。"
          },
          {
            "jp": "明日、学校に来られますか。",
            "zh": "明天能來學校嗎？"
          }
        ]
      },
      {
        "pattern": "可能形與普通形四格",
        "meaning": "可能形也有現在肯定、現在否定、過去肯定、過去否定。",
        "connection": "読める／読めない／読めた／読めなかった；食べられる／食べられない／食べられた／食べられなかった。",
        "usage": "『読む』是讀；『読める』是能讀。『食べない』是不吃；『食べられない』是不能吃。",
        "examples": [
          {
            "jp": "昨日は忙しくて本が読めなかった。",
            "zh": "昨天很忙，沒辦法讀書。"
          },
          {
            "jp": "今日は漢字が読める。",
            "zh": "今天能讀漢字。"
          },
          {
            "jp": "前は泳げなかったが、今は泳げる。",
            "zh": "以前不會游泳，現在會了。"
          }
        ]
      },
      {
        "pattern": "N5間隔複習：～てもいいです／～なければなりません",
        "meaning": "可以做／必須做，與能力可能形不同。",
        "connection": "開けて＋もいいです；行かない去い＋ければなりません。",
