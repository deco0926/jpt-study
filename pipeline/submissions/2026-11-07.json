    "grammar": [
      {
        "pattern": "五段る與一段る的分類",
        "meaning": "切る・帰る・始まる・終わる屬五段；借りる・開ける・閉める・忘れる・始める屬一段。",
        "connection": "五段る→らない／った／らなかった；一段去る→ない／た／なかった。",
        "usage": "い段或え段＋る常見一段，但切る、帰る是例外，必須記住。",
        "examples": [
          {
            "jp": "紙を切らない。",
            "zh": "不剪紙。"
          },
