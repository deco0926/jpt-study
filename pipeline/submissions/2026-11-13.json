    "grammar": [
      {
        "pattern": "～ば：五段動詞條件形",
        "meaning": "表示「如果～就～」，常用於規則、條件及預測。",
        "connection": "五段動詞最後う段改え段＋ば：急ぐ→急げば、行く→行けば、間に合う→間に合えば。",
        "usage": "先看條件再看結果；不是過去式。",
        "examples": [
          {
            "jp": "急げば、授業に間に合います。",
            "zh": "如果趕快，就趕得上課。"
          },
          {
            "jp": "駅に行けば、バスがあります。",
            "zh": "如果去車站，就有公車。"
          },
          {
            "jp": "時間に間に合えば、一緒に出発します。",
            "zh": "如果趕得上時間，就一起出發。"
          }
        ]
      },
      {
        "pattern": "～ば：一段動詞及不規則動詞",
        "meaning": "一段動詞去る加れば；する→すれば、来る→来れば。",
        "connection": "調べる→調べれば、知らせる→知らせれば、する→すれば、来る（くる）→来れば（くれば）。",
        "usage": "用於「如果查詢／通知／做／來」等假設。",
        "examples": [
          {
            "jp": "時間を調べれば、わかります。",
            "zh": "如果查詢時間就會知道。"
          },
          {
            "jp": "早く知らせれば、準備できます。",
            "zh": "如果早點通知，就能準備。"
          },
          {
            "jp": "準備をすれば、大丈夫です。",
            "zh": "如果做準備，就沒問題。"
          }
        ]
      },
      {
        "pattern": "い形容詞／な形容詞／名詞的條件",
        "meaning": "い形容詞去い＋ければ；な形容詞及名詞＋なら（ば），表示假設條件。",
        "connection": "早い→早ければ；忙しい→忙しければ；便利→便利なら；明日→明日なら。いい→よければ。",
        "usage": "不要把な形容詞直接加ければ。",
        "examples": [
          {
            "jp": "出発が早ければ、間に合います。",
            "zh": "如果出發得早，就趕得上。"
          },
          {
            "jp": "明日なら、大丈夫です。",
            "zh": "如果是明天就沒問題。"
          },
          {
            "jp": "時間がよければ、連絡してください。",
            "zh": "如果時間方便，請聯絡我。"
          }
        ]
      },
      {
        "pattern": "～たら：完成條件與假設",
        "meaning": "動詞た形＋ら；可表示「如果～」或「做完～之後」。",
        "connection": "調べた→調べたら；出発した→出発したら；着いた→着いたら。",
        "usage": "～たら較適合表達先完成前項再進行後項；～ば常強調一般條件。",
        "examples": [
          {
            "jp": "駅に着いたら、連絡してください。",
            "zh": "到車站後請聯絡。"
          },
          {
            "jp": "時間を調べたら、知らせます。",
            "zh": "查完時間就通知。"
          },
          {
            "jp": "雨が降ったら、出発しません。",
            "zh": "如果下雨，就不出發。"
          }
        ]
      },
      {
        "pattern": "N5間隔複習：～ないでください／～てもいいです",
        "meaning": "請不要做／可以做；與條件形不同。",
        "connection": "遅れる→遅れないでください；調べる→調べてもいいです。",
        "usage": "複習ない形、て形與助詞に／を。",
        "examples": [
