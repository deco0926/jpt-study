    "grammar": [
      {
        "pattern": "ない形三類：新動詞實戰",
        "meaning": "五段動詞把う段改為あ段＋ない；一段去る＋ない；する／来る是不規則。",
        "connection": "話す→話さない、待つ→待たない、遊ぶ→遊ばない；起きる→起きない；する→しない；来る→来ない。",
        "usage": "先判斷類型再變化；不要看到る就一律去る。",
        "examples": [
          {
            "jp": "今日は友達と話さない。",
            "zh": "今天不和朋友說話。"
          },
          {
            "jp": "駅で待たない。",
            "zh": "不在車站等。"
          },
          {
            "jp": "明日は早く起きない。",
            "zh": "明天不早起。"
          }
        ]
      },
      {
        "pattern": "普通形四格：時間詞＋句尾",
        "meaning": "現在／未來肯定用辭書形，否定用ない形；過去肯定用た形，過去否定用なかった。",
        "connection": "遊ぶ／遊ばない／遊んだ／遊ばなかった；起きる／起きない／起きた／起きなかった。",
        "usage": "閱讀先找昨日／今日／明日／もう，再看句尾，不要只看動詞字根。",
