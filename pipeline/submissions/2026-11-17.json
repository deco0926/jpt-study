    "grammar": [
      {
        "pattern": "補課核心：普通形四格與五段／一段辨識",
        "meaning": "普通形有非過去肯定、非過去否定、過去肯定、過去否定四格；る結尾不一定是一段動詞。",
        "connection": "五段：帰る→帰らない→帰った→帰らなかった；一段：決める→決めない→決めた→決めなかった；不規則：する→しない→した→しなかった。",
        "usage": "先辨動詞類別，再轉換時態；帰る是五段，決める是一段。",
        "examples": [
          {
            "jp": "明日は早く帰る。",
            "zh": "明天早點回去。"
          },
          {
            "jp": "昨日は帰らなかった。",
            "zh": "昨天沒回去。"
          },
          {
            "jp": "予定を決めた。",
            "zh": "決定了行程。"
          }
        ]
      },
      {
        "pattern": "普通形＋と思います（動詞）",
        "meaning": "表示『我認為／我覺得……』，也可表推測。",
        "connection": "動詞普通形＋と思います；行くと思います／行かないと思います／行ったと思います／行かなかったと思います。",
        "usage": "と思います前用普通形，不接行きますと思います。主句と思います保持禮貌形。",
        "examples": [
          {
            "jp": "明日は雨が降ると思います。",
            "zh": "我覺得明天會下雨。"
          },
          {
            "jp": "彼は遅れないと思います。",
            "zh": "我覺得他不會遲到。"
          },
