            "zh": "今天不必去。"
          },
          {
            "jp": "明日は行かなければなりません。",
            "zh": "明天必須去。"
          },
          {
            "jp": "ここで食べてもいいです。",
            "zh": "這裡可以吃。"
          }
        ]
      }
