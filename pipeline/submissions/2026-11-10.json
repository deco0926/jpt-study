    "grammar": [
      {
        "pattern": "可能形複習：五段動詞",
        "meaning": "表示能做；五段動詞う段改え段＋る。",
        "connection": "行く→行ける；読む→読める；会う→会える；話す→話せる。",
        "usage": "能力與條件；否定行けない、過去行けた、過去否定行けなかった。",
        "examples": [
          {
            "jp": "明日は学校に行けます。",
            "zh": "明天能去學校。"
          },
          {
            "jp": "この本が読めません。",
            "zh": "不能讀這本書。"
          },
          {
            "jp": "昨日は友達に会えなかった。",
            "zh": "昨天沒辦法見朋友。"
          }
        ]
      },
      {
        "pattern": "可能形複習：一段與不規則",
        "meaning": "一段去る＋られる；する→できる；来る→来られる（こられる）。",
        "connection": "食べる→食べられる；調べる→調べられる；準備する→準備できる。",
        "usage": "標準形式保留ら；能力對象常用が。",
        "examples": [
          {
            "jp": "辛い物が食べられます。",
            "zh": "能吃辣。"
          },
          {
            "jp": "今日、準備ができます。",
            "zh": "今天能準備。"
          },
          {
            "jp": "明日は来られません。",
            "zh": "明天不能來。"
          }
        ]
      },
      {
        "pattern": "N4新文法：意向形（五段）",
        "meaning": "表達「來做吧／打算做」的意志，常用於提議。",
        "connection": "五段う段改お段＋う：行く→行こう、読む→読もう、会う→会おう、話す→話そう。",
        "usage": "朋友間提議可用意向形；禮貌提議常用～ましょう（行きましょう）。",
        "examples": [
          {
            "jp": "明日、一緒に行こう。",
            "zh": "明天一起去吧。"
          },
          {
            "jp": "この本を読もう。",
            "zh": "來讀這本書吧。"
          },
          {
            "jp": "友達に会おう。",
            "zh": "去見朋友吧。"
          }
        ]
      },
      {
        "pattern": "N4新文法：意向形（一段／不規則）",
        "meaning": "一段去る＋よう；する→しよう；来る→来よう（こよう）。",
        "connection": "食べる→食べよう、決める→決めよう、調べる→調べよう、準備する→準備しよう。",
        "usage": "意向形與可能形不同：食べよう＝來吃吧；食べられる＝能吃。",
        "examples": [
          {
            "jp": "時間を決めよう。",
            "zh": "來決定時間吧。"
          },
          {
            "jp": "電車の時間を調べよう。",
            "zh": "來查電車時間吧。"
          },
          {
            "jp": "試験の準備をしよう。",
            "zh": "來準備考試吧。"
          }
        ]
      },
      {
        "pattern": "N4新文法：～ようと思います",
        "meaning": "表示說話者目前打算做某事，語氣較柔和。",
        "connection": "動詞意向形＋と思います：行こうと思います、調べようと思います。",
        "usage": "第一人稱計畫常用；與單純能力形區分。",
        "examples": [
          {
            "jp": "明日、図書館に行こうと思います。",
            "zh": "我打算明天去圖書館。"
          },
          {
            "jp": "今夜、試験の準備をしようと思います。",
            "zh": "我打算今晚準備考試。"
          },
          {
            "jp": "予定を変更しようと思います。",
            "zh": "我打算變更計畫。"
          }
        ]
      },
      {
        "pattern": "N5間隔複習：許可／義務與否定",
        "meaning": "能做（可能形）不等於可以做（許可）；必須做又是不同意思。",
        "connection": "行ける＝能去；行ってもいい＝可以去；行かなければならない＝必須去；行かなくてもいい＝不必去。",
        "usage": "辨認～てもいい、～なければなりません、～なくてもいいです。",
        "examples": [
