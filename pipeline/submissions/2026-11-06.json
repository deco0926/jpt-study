    "grammar": [
      {
        "pattern": "五段る動詞與一段る動詞辨識",
        "meaning": "る結尾不代表一定是一段。切る、帰る、走る、入る是五段；借りる、開ける、閉める、忘れる、始める是一段。",
        "connection": "五段る→らない／った／らなかった；一段る去る→ない／た／なかった。",
        "usage": "遇到い段或え段＋る，先查動詞類型，不能只看最後一字。",
        "examples": [
          {
            "jp": "紙を切らない。",
            "zh": "不剪紙。"
          },
          {
            "jp": "昨日、六時に帰った。",
            "zh": "昨天六點回家。"
          },
          {
            "jp": "図書館で本を借りた。",
            "zh": "在圖書館借了書。"
          }
        ]
      },
      {
        "pattern": "普通形四格：五段る",
        "meaning": "現在肯定、現在否定、過去肯定、過去否定的四格。",
        "connection": "切る／切らない／切った／切らなかった；帰る／帰らない／帰った／帰らなかった；走る／走らない／走った／走らなかった。",
        "usage": "五段る的ない形是らない，不是去る直接加ない。",
        "examples": [
          {
            "jp": "今日は紙を切らない。",
            "zh": "今天不剪紙。"
          },
          {
            "jp": "昨日は家に帰らなかった。",
            "zh": "昨天沒有回家。"
          },
          {
            "jp": "昨日、公園を走った。",
            "zh": "昨天在公園跑了步。"
          }
        ]
      },
      {
        "pattern": "普通形四格：一段る",
        "meaning": "一段動詞去掉る，依序加ない、た、なかった。",
        "connection": "借りる／借りない／借りた／借りなかった；開ける／開けない／開けた／開けなかった；閉める／閉めない／閉めた／閉めなかった。",
        "usage": "不要把借りる錯變成借らない。",
        "examples": [
          {
            "jp": "昨日、本を借りた。",
            "zh": "昨天借了書。"
          },
          {
            "jp": "朝、窓を開けなかった。",
            "zh": "早上沒有開窗。"
          },
          {
            "jp": "ドアを閉めない。",
            "zh": "不關門。"
          }
        ]
      },
      {
        "pattern": "普通形＋と思います",
        "meaning": "表示我認為、我想；引用自己對事情的判斷。",
        "connection": "動詞普通形＋と思います：帰ると思います／帰らないと思います／帰ったと思います。名詞及な形容詞現在肯定＋だと思います。",
        "usage": "先確認普通形的時態及肯否，再接と思います。",
        "examples": [
          {
            "jp": "明日は雨が降ると思います。",
            "zh": "我想明天會下雨。（雨が降る：下雨）"
          },
          {
            "jp": "友達はもう帰ったと思います。",
            "zh": "我想朋友已經回家了。"
          },
          {
            "jp": "明日は遊ばないと思います。",
            "zh": "我想明天不會玩。"
          }
        ]
      },
      {
        "pattern": "N5間隔複習：てください、なければなりません、たことがあります",
        "meaning": "複習請求、義務與經驗，和今日活用連結。",
        "connection": "動詞て形＋ください；ない形去い＋ければなりません；た形＋ことがあります。",
        "usage": "辨別必須做與曾做過，不混淆時態。",
        "examples": [
          {
            "jp": "ドアを閉めてください。",
            "zh": "請關門。"
          },
          {
            "jp": "早く起きなければなりません。",
            "zh": "必須早起。"
          },
          {
            "jp": "本を借りたことがあります。",
            "zh": "曾經借過書。"
          }
        ]
      },
      {
        "pattern": "閱讀與文字模擬聽解",
        "meaning": "先讀懂時間詞再找動詞末尾：昨日＝昨天、明日＝明天、もう＝已經、そのあと＝之後。",
        "connection": "閱讀：昨日、図書館で本を借りました。そのあと家に帰りました。明日は友達と遊ぶ予定です。／文字聽解：A「もう帰りましたか。」B「いいえ、まだ帰っていません。」",
        "usage": "閱讀問：昨天做了什麼、之後去哪裡、明天預定什麼？文字模擬聽解問：B已回家了嗎？（不是音檔）",
        "examples": [
          {
            "jp": "昨日、図書館で本を借りました。",
            "zh": "昨天在圖書館借了書。"
          },
          {
            "jp": "そのあと家に帰りました。",
            "zh": "之後回家了。"
          },
          {
            "jp": "いいえ、まだ帰っていません。",
            "zh": "不，還沒有回家。"
          }
        ]
      }
