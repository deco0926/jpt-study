    "grammar": [
      {
        "pattern": "普通形四格：行く・食べる・する",
        "meaning": "現在肯定用辭書形、否定用ない形；過去肯定用た形、過去否定用なかった。",
        "connection": "行く／行かない／行った／行かなかった；食べる／食べない／食べた／食べなかった；する／しない／した／しなかった。",
        "usage": "先判斷時間與肯否，再選動詞結尾；行く的た形是行った。",
        "examples": [
          {
            "jp": "明日は学校に行く。",
            "zh": "明天去學校。"
          },
          {
            "jp": "昨日は学校に行かなかった。",
            "zh": "昨天沒有去學校。"
          },
          {
            "jp": "昨日は日本語を勉強した。",
            "zh": "昨天學了日文。"
          }
        ]
      },
      {
        "pattern": "五段與一段：る動詞的ない形",
        "meaning": "不能看到る就一律去る。切る、帰る是五段；借りる、決める、調べる是一段。",
        "connection": "五段：切る→切らない、帰る→帰らない；一段：借りる→借りない、決める→決めない、調べる→調べない。",
        "usage": "先記住常見例外，再練轉換。",
        "examples": [
          {
            "jp": "今日は紙を切らない。",
            "zh": "今天不剪紙。"
          },
          {
            "jp": "明日は本を借りない。",
            "zh": "明天不借書。"
          },
          {
            "jp": "まだ時間を決めない。",
            "zh": "還不決定時間。"
          }
        ]
      },
      {
        "pattern": "普通形＋と思います",
        "meaning": "表示『我認為／我想』，前面要接普通形。",
        "connection": "動詞：行く／行かない／行った＋と思います；い形容詞：高いと思います；な形容詞／名詞現在肯定：必要だ／先生だと思います。",
        "usage": "な形容詞與名詞肯定現在時不可用『なと思います』。",
        "examples": [
          {
            "jp": "明日は雨が降ると思います。",
            "zh": "我想明天會下雨。"
          },
          {
            "jp": "今日は遅れないと思います。",
            "zh": "我想今天不會遲到。"
          },
          {
            "jp": "準備が必要だと思います。",
            "zh": "我認為準備是必要的。"
          }
        ]
      },
      {
        "pattern": "～前に／～てから：先後順序",
        "meaning": "前に表示在某事之前；てから表示做完某事之後再做另一事。",
        "connection": "動詞辭書形＋前に；動詞て形＋から。例：出発する前に／確認してから。",
        "usage": "時間順序題要看前後動作，不要只看句子排列。",
        "examples": [
          {
            "jp": "出発する前に、時間を確認します。",
            "zh": "出發前確認時間。"
          },
