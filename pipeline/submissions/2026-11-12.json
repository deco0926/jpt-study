    "grammar": [
      {
        "title": "意向形複習：～よう／～おう",
        "meaning": "表示意志或提議『一起做吧』",
        "connection": "五段う段→お段＋う：誘う→誘おう；一段去る＋よう：食べる→食べよう；する→しよう；来る→来よう（こよう）",
        "usage": "與可能形區別：行こう＝去吧；行ける＝能去。",
        "examples": [
          {
            "jp": "一緒に出発しよう。",
            "zh": "一起出發吧。"
          },
          {
            "jp": "友達を誘おう。",
            "zh": "邀請朋友吧。"
          },
          {
            "jp": "早く帰ろう。",
            "zh": "早點回家吧。"
          }
        ]
      },
      {
        "title": "～ようと思っています",
        "meaning": "之前已有、現在仍持續的打算",
        "connection": "動詞意向形＋と思っています；否定意圖可用～ないつもりです；～ようと思います也可表示當下決定。",
