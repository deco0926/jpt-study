  "grammar": [
    {
      "pattern": "名詞＋は＋い形容詞＋です／い→くないです",
      "meaning": "用い形容詞描述名詞；否定時把最後的い改成くないです。",
      "connection": "高い→高くないです；安い→安くないです；おいしい→おいしくないです。",
      "usage": "今日先掌握現在肯定與否定，不延伸到完整過去式變化。",
      "examples": [
        {
          "jp": "このホテルは高いです。",
          "zh": "這間飯店很貴。"
        },
        {
          "jp": "このホテルは高くないです。",
          "zh": "這間飯店不貴。"
        },
        {
          "jp": "このご飯はおいしくないです。",
          "zh": "這份飯不好吃。"
        }
      ]
    },
    {
      "pattern": "名詞＋は＋な形容詞＋です／ではありません",
      "meaning": "用な形容詞描述名詞；否定使用ではありません，口語也常說じゃありません。",
      "connection": "句尾不加な；静かです→静かではありません。",
      "usage": "和い形容詞的否定「くないです」分開記。",
      "examples": [
        {
          "jp": "この町は静かです。",
          "zh": "這個城鎮很安靜。"
        },
        {
          "jp": "この町は静かではありません。",
          "zh": "這個城鎮不安靜。"
        },
        {
          "jp": "駅は便利です。",
          "zh": "車站很方便。"
        }
      ]
    },
    {
      "pattern": "い形容詞＋名詞／な形容詞＋な＋名詞",
      "meaning": "い形容詞直接接名詞；な形容詞修飾名詞時要加な。",
      "connection": "大きい店、新しいホテル、静かな町、便利な駅。",
      "usage": "不要說「静か町」，應說「静かな町」。",
      "examples": [
        {
          "jp": "大きい店",
          "zh": "大間的店"
        },
        {
          "jp": "新しいホテル",
          "zh": "新的飯店"
        },
        {
          "jp": "静かな町",
          "zh": "安靜的城鎮"
        }
      ]
    },
    {
      "pattern": "この～／～も／どうですか",
      "meaning": "この～表示「這個～」；も表示「也」；どうですか表示「怎麼樣？」",
      "connection": "この後接名詞；も取代は等提示「也」；どうですか用來詢問狀態或評價。",
      "usage": "用於今日的飯店、店家閱讀與聽解。",
      "examples": [
        {
          "jp": "このホテルはどうですか。",
          "zh": "這間飯店怎麼樣？"
        },
        {
          "jp": "ご飯もおいしいです。",
          "zh": "飯也很好吃。"
        },
        {
          "jp": "安いです。そして、駅に近いです。",
          "zh": "很便宜，而且離車站很近。"
        }
      ]
    },
    {
      "pattern": "ます／ません／ました／ませんでした／～ませんか",
      "meaning": "複習動詞的現在／未來肯定、否定、過去肯定、過去否定，以及禮貌邀請。",
      "connection": "行きます→行きません→行きました→行きませんでした；行きませんか是邀請。",
      "usage": "注意行きません與行きませんか只差か，但意思不同。",
      "examples": [
        {
          "jp": "昨日、学校に行きませんでした。",
          "zh": "昨天沒有去學校。"
        },
        {
          "jp": "一緒に行きませんか。",
          "zh": "要不要一起去？"
        },
        {
          "jp": "昨日、新しい店に行きました。",
          "zh": "昨天去了一間新店。"
        }
      ]
    }
  ],
