  "vocab": [
    {
      "word": "今日",
      "reading": "きょう / kyou",
      "meaning": "今天",
      "usage": "常放句首表示時間。",
      "example": "今日は学校に行きます。",
      "translation": "今天去學校。"
    },
    {
      "word": "明日",
      "reading": "あした / ashita",
      "meaning": "明天",
      "usage": "常搭配現在／未來的ます形。",
      "example": "明日、学校に行きます。",
      "translation": "明天去學校。"
    },
    {
      "word": "友達",
      "reading": "ともだち / tomodachi",
      "meaning": "朋友",
      "usage": "「私の友達」＝我的朋友。",
      "example": "私の友達です。",
      "translation": "是我的朋友。"
    },
    {
      "word": "家",
      "reading": "いえ / ie",
      "meaning": "家",
      "usage": "目的地時可接「に」。",
      "example": "家に行きます。",
      "translation": "去家裡。"
    },
    {
      "word": "一緒に",
      "reading": "いっしょに / issho ni",
      "meaning": "一起",
      "usage": "常和「行きます／食べます」搭配。",
      "example": "一緒に行きます。",
      "translation": "一起去。"
    },
    {
      "word": "誰",
      "reading": "だれ / dare",
      "meaning": "誰、哪個人",
      "usage": "「誰ですか」＝是誰？",
      "example": "誰ですか。",
      "translation": "是誰？"
    }
  ],
  "grammar": [
    {
      "pattern": "地方 ＋ へ ＋ 行きます",
      "meaning": "前往某地、朝某方向去。",
      "connection": "地點名詞後加「へ」。當助詞時「へ」通常念 e。",
      "usage": "初級階段可先理解為和「に」很接近；に較著重目的地，へ較有前往方向感。",
      "examples": [
        {
          "jp": "学校へ行きます。",
          "zh": "去學校。"
        },
        {
          "jp": "日本へ行きます。",
          "zh": "去日本。"
        },
        {
          "jp": "ホテルへ行きます。",
          "zh": "去飯店。"
        }
      ]
    },
    {
      "pattern": "～ですか",
      "meaning": "～嗎？用來形成疑問句。",
      "connection": "在「です」等句尾後加「か」。",
      "usage": "看到句尾「か」要先反應為提問。",
      "examples": [
        {
          "jp": "学生ですか。",
          "zh": "是學生嗎？"
        },
        {
          "jp": "ホテルですか。",
          "zh": "是飯店嗎？"
        },
        {
          "jp": "誰ですか。",
          "zh": "是誰？"
        }
      ]
    }
  ],
