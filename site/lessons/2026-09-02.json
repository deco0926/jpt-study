  "grammar": [
    {
      "pattern": "ます／ません／ました／ませんでした",
      "meaning": "分別表示現在／未來肯定、現在／未來否定、過去肯定、過去否定。",
      "connection": "ます→ました；ません→ませんでした。",
      "usage": "聽力時要聽到動詞句尾最後，避免只聽前半就作答。",
      "examples": [
        {
          "jp": "アイスを食べます。",
          "zh": "吃／會吃冰淇淋。"
        },
        {
          "jp": "アイスを食べません。",
          "zh": "不吃／不會吃冰淇淋。"
        },
        {
          "jp": "アイスを食べました。",
          "zh": "吃了冰淇淋。"
        },
        {
          "jp": "アイスを食べませんでした。",
          "zh": "沒有吃冰淇淋。"
        }
      ]
    },
    {
      "pattern": "時間詞 ＋ 動詞時態",
      "meaning": "昨日常搭配過去式；今日／明日常搭配現在／未來形式。",
      "connection": "時間詞通常放句首，動詞句尾決定肯定／否定與時態。",
      "usage": "JPT常用時間詞與句尾做陷阱。",
      "examples": [
        {
          "jp": "昨日、学校に行きました。",
          "zh": "昨天去了學校。"
        },
        {
          "jp": "今日、学校に行きます。",
          "zh": "今天去學校。"
        },
        {
          "jp": "明日、学校に行きません。",
          "zh": "明天不去學校。"
        }
      ]
    },
    {
      "pattern": "～ませんか",
      "meaning": "要不要一起～？用於禮貌邀請。",
      "connection": "動詞ます形的「ます」改為「ませんか」。",
      "usage": "初學先優先理解成邀請，而不是單純否定問句。",
      "examples": [
        {
          "jp": "一緒に行きませんか。",
          "zh": "要不要一起去？"
        },
        {
          "jp": "一緒に食べませんか。",
          "zh": "要不要一起吃？"
        },
        {
          "jp": "明日、友達と一緒に駅へ行きませんか。",
          "zh": "明天要不要和朋友一起去車站？"
        }
      ]
    }
  ],
