  "grammar": [
    {
      "pattern": "五段與一段：る結尾不能只看外形",
      "meaning": "切る、帰る屬五段；借りる、開ける、閉める、忘れる屬一段。",
      "connection": "五段る→らない／った：切る→切らない→切った；一段去る＋ない／た：借りる→借りない→借りた。",
      "usage": "先背常見例外，再判斷動詞類別。",
      "examples": [
        {
          "jp": "紙を切らない。",
          "zh": "不剪紙。"
        },
        {
          "jp": "今日は早く帰った。",
          "zh": "今天早點回家了。"
        },
        {
          "jp": "本を借りた。",
          "zh": "借了書。"
        }
      ]
    },
    {
      "pattern": "普通形四格：現在肯定、否定、過去肯定、否定",
      "meaning": "以辭書形、ない形、た形、なかった表達四種時態／極性。",
      "connection": "借りる／借りない／借りた／借りなかった；帰る／帰らない／帰った／帰らなかった。",
      "usage": "與ます／ません／ました／ませんでした對照。",
      "examples": [
        {
          "jp": "昨日は本を借りなかった。",
          "zh": "昨天沒有借書。"
        },
        {
          "jp": "明日は家に帰る。",
          "zh": "明天回家。"
        },
        {
          "jp": "昨日は早く帰った。",
          "zh": "昨天早點回家了。"
        }
      ]
    },
    {
      "pattern": "一段動詞：ない形與た形",
      "meaning": "一段動詞去掉最後的る，加ない或た。",
      "connection": "開ける→開けない／開けた；閉める→閉めない／閉めた；忘れる→忘れない／忘れた。",
      "usage": "也可用ない→なかった構成過去否定。",
      "examples": [
