  "grammar": [
    {
      "pattern": "交通工具 ＋ で ＋ 行きます",
      "meaning": "搭／使用某種交通工具去。",
      "connection": "交通工具名詞後加「で」。",
      "usage": "今天先把「で」當成交通手段標記。",
      "examples": [
        {
          "jp": "電車で行きます。",
          "zh": "搭電車去。"
        },
        {
          "jp": "バスで行きます。",
          "zh": "搭公車去。"
        },
        {
          "jp": "タクシーでホテルに行きます。",
          "zh": "搭計程車去飯店。"
        }
      ],
      "category": "助詞",
      "firstSeen": "2026-08-29",
      "lastSeen": "2026-08-29"
    },
    {
      "pattern": "目的地 ＋ に ＋ 行きます",
      "meaning": "去某個地方。",
      "connection": "地點名詞後加「に」。",
      "usage": "今天先把「に」當成目的地標記。",
      "examples": [
        {
          "jp": "駅に行きます。",
          "zh": "去車站。"
